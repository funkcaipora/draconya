#!/usr/bin/env bash
# Git hook commit-msg -- pega commit feito fora do Claude Code (linha de comando, GUI).
#
# Mesma regra de .claude/hooks/validate-commit.sh, duplicada de proposito: sao dois scripts
# pequenos, com contratos de hook diferentes (git commit-msg le um arquivo; o hook do Claude
# Code le JSON do stdin), e nao vale a pena abstrair isso numa lib compartilhada.
#
# Para ativar neste clone:
#   git config core.hooksPath .githooks
#
# Formato exigido (docs/harness-plan.md secao 4.1, CLAUDE.md):
#
#   <tipo>(<escopo>): <descricao no imperativo> (#nn)
#
#   tipo:   feat | fix | refactor | perf | docs | test | chore
#   escopo: sim | protocol | content | server | client | tools | docs | deps
#
# (#nn) e obrigatorio, exceto para tipo chore ou docs -- nn e a issue do GitHub. (FUN-nn), a issue
# do Linear, continua aceito so para branch aberta antes de 2026-09-12; trabalho novo nao usa.
#
# Contrato do hook commit-msg: exit 0 aceita o commit; exit != 0 aborta e o git mostra o
# stderr deste script para quem esta commitando.

set -u

message_file="${1:-}"
[ -n "$message_file" ] && [ -r "$message_file" ] || exit 0

# Commit de merge e isento: ele nao descreve uma mudanca, descreve uma juncao. O assunto que
# o git gera sozinho ("Merge branch 'x' into y") nunca vai bater no formato, e inventar um
# `chore(server): merge main and ...` so para passar no hook nao acrescenta informacao a
# ninguem -- so ensina a contornar o hook.
#
# A deteccao e por MERGE_HEAD, nao pelo prefixo "Merge " do assunto: assunto e texto livre e
# qualquer commit normal pode comecar com essa palavra. MERGE_HEAD so existe entre o inicio
# de um merge e o commit que o conclui, entao o unico commit criado com ele presente e o
# proprio merge -- inclusive o `git commit` manual que fecha um merge com conflito. Commit
# normal continua validado; nao existe janela em que a regra afrouxe.
if git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
  exit 0
fi

TYPES='feat|fix|refactor|perf|docs|test|chore'
SCOPES='sim|protocol|content|server|client|tools|docs|deps'

fail() {
  cat >&2 <<MSG
commit rejected by hook commit-msg: $1

expected format:
  <type>(<scope>): <imperative description in English> (#nn)

  type:   feat | fix | refactor | perf | docs | test | chore
  scope: sim | protocol | content | server | client | tools | docs | deps

(#nn) -- the GitHub issue -- is required except for chore and docs commits.
(FUN-nn) is only accepted for branches opened before the move to GitHub issues.
example: feat(sim): advance simulation using elapsed time (#150)
MSG
  exit 1
}

# primeira linha nao vazia e que nao seja comentario (git usa '#' por padrao antes do
# cleanup da mensagem final)
subject=""
while IFS= read -r line; do
  case "$line" in
    '#'*) continue ;;
  esac
  if [ -n "${line//[[:space:]]/}" ]; then
    subject="$line"
    break
  fi
done < "$message_file"

[ -n "$subject" ] || exit 0

subject="$(printf '%s' "$subject" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')"
[ -n "$subject" ] || exit 0

if [[ "$subject" =~ ^([A-Za-z0-9_-]+)\(([A-Za-z0-9_-]+)\):[[:space:]]*(.*)$ ]]; then
  type="${BASH_REMATCH[1]}"
  scope="${BASH_REMATCH[2]}"
  remainder="${BASH_REMATCH[3]}"
else
  fail "\"$subject\" does not match <type>(<scope>): <description> (#nn)"
fi

if [[ ! "$type" =~ ^($TYPES)$ ]]; then
  fail "type \"$type\" is invalid in \"$subject\" -- use one of: feat, fix, refactor, perf, docs, test, chore"
fi

if [[ ! "$scope" =~ ^($SCOPES)$ ]]; then
  fail "scope \"$scope\" is invalid in \"$subject\" -- use one of: sim, protocol, content, server, client, tools, docs, deps"
fi

description="$remainder"
has_issue=0
if [[ "$remainder" =~ ^(.*[^[:space:]])[[:space:]]+\((#[0-9]+|FUN-[0-9]+)\)[[:space:]]*$ ]]; then
  has_issue=1
  description="${BASH_REMATCH[1]}"
fi

if [ -z "$description" ]; then
  fail "empty description in \"$subject\""
fi

if [[ "$type" != "chore" && "$type" != "docs" && "$has_issue" -eq 0 ]]; then
  fail "missing (#nn) in \"$subject\" -- required for type '$type' (only chore and docs are exempt)"
fi

exit 0
