{
  "version": "0.0.1",
  "autoPort": true,
  "configurations": [
    {
      "name": "server",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "client",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
