{
  "name": "draconya",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @draconya/client build",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "typecheck": "tsc -b --force && tsc -p tsconfig.tooling.json && tsc -p packages/client/tsconfig.json && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "docs-check": "tsx scripts/docs-check.ts",
    "source-policy": "tsx scripts/source-policy.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm docs-check && pnpm source-policy",
    "dev": "tsx watch --env-file=.env packages/server/src/main.ts",
    "content:check": "pnpm --filter @draconya/tools content:check"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@typescript-eslint/parser": "^8.70.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.17.0",
    "jiti": "^2.7.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "zod": "^4.5.4"
  }
}
