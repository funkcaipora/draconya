{
  "name": "draconya",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @draconya/client build",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:wipe-characters": "tsx --env-file-if-exists=.env scripts/wipe-characters.ts",
    "typecheck": "tsc -b --force && tsc -p tsconfig.tooling.json && tsc -p packages/client/tsconfig.json && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "docs-check": "tsx scripts/docs-check.ts",
    "source-policy": "tsx scripts/source-policy.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm docs-check && pnpm source-policy && pnpm assets:inventory --check && pnpm map:import --check",
    "dev": "tsx watch --env-file=.env packages/server/src/main.ts",
    "content:check": "tsc -b && pnpm --filter @draconya/tools content:check",
    "assets:library": "tsx scripts/build-asset-library.ts",
    "assets:inventory": "tsx scripts/pack-inventory.ts",
    "assets:fetch:1098": "tsx scripts/fetch-open-tibia-assets.ts",
    "map:fetch": "tsx scripts/fetch-map.ts",
    "map:import": "tsx scripts/import-map.ts",
    "route:trace": "tsx scripts/trace-route.ts",
    "bench:monster": "tsc -b && pnpm --filter @draconya/tools bench:monster",
    "bench:hunts": "tsc -b && pnpm --filter @draconya/tools bench:hunts",
    "bench:combat": "tsc -b && pnpm --filter @draconya/tools bench:combat",
    "bench:city": "tsc -b && pnpm --filter @draconya/tools bench:city",
    "load": "tsc -b && pnpm --filter @draconya/tools load"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "@typescript-eslint/parser": "^8.70.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "ioredis": "^6.0.0",
    "jiti": "^2.7.0",
    "postgres": "^3.4.9",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "zod": "^4.6.2"
  }
}
