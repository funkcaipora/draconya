# Copie para .env e ajuste. .env não é versionado.

# Papéis: api,game,jobs por padrão. Ex.: PROCESSES=game não abre Postgres.
PROCESSES=api,game,jobs
# Obrigatória só em api/jobs. Redis é obrigatório em todos.
DATABASE_URL=postgres://draconya:draconya@localhost:5432/draconya
REDIS_URL=redis://localhost:6379

# Processo api
API_PORT=3000
API_ORIGIN=http://localhost:5173

# Processo game
GAME_PORT=7171
# /metrics do jobs (FUN-59). Só Prometheus; sem autenticação, quem esconde é a rede.
JOBS_PORT=3001
# Em produção com game: wss://<host>/ws. Sem credenciais, query ou fragmento.
GAME_PUBLIC_URL=ws://localhost:7171
# Identidade do nó no diretório de sessões. Vazio usa o hostname; com mais de um nó de
# jogo na mesma máquina, cada um precisa do seu.
# NODE_ID=game-1

# Autenticação do api (WorkOS); game/jobs não exigem essas credenciais. Deixe vazio para usar o modo de desenvolvimento,
# que aceita qualquer e-mail sem verificar — nunca ligue isso em produção.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Sessão HTTP local do Draconya, em segundos.
AUTH_SESSION_TTL_SECONDS=43200
AUTH_DEV_MODE=true

# Diretório de `content`. Relativo ao diretório de execução: a raiz do repositório em
# desenvolvimento, /app na imagem. O caminho resolvido aparece no log de boot.
CONTENT_DIR=./packages/content/data

# Pacote de assets do cliente Tibia. Não versionado (things/ está no .gitignore). O boot
# recusa subir se THINGS_VERSION não for a versão contra a qual o conteúdo foi conferido
# (packages/content/data/packs/, FUN-21) — em produção o compose deriva VITE_THINGS_URL dela.
THINGS_VERSION=1332
# Apenas tooling/testes de assets; não é configuração do servidor.
THINGS_DIR=./things
# De onde o CLIENTE busca o pacote, com a versão no caminho. Mesma origem: em dev o Vite serve
# `things/` da raiz do repositório; em produção, o nginx (deploy/nginx.conf).
VITE_THINGS_URL=/things/1332

LOG_LEVEL=debug

# Matriz completa e persistência entre papéis: docs/runtime-configuration.md
